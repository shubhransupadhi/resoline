# Resoline Techbis Environment Variables Template
# Copy this file to .env and configure for local development or CI/CD

# Site Information
NEXT_PUBLIC_SITE_URL=https://resoline.in
SITE_NAME="Resoline Techbis Private Limited"
CONTACT_EMAIL=contact@resoline.in
SUPPORT_PHONE=+91637053100

# Rate Limiting & Security Controls
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=5

# Lead Intake / Webhook Integration (Optional)
LEAD_WEBHOOK_URL=
WEB3FORMS_ACCESS_KEY=

# Error Monitoring (Sentry)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
